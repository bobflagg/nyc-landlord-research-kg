# Copy to .env (gitignored) and fill in.

# Local development Neo4j (docker-compose.yml)
NEO4J_PASSWORD=change-me
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
# Raise both for the citywide graph (see README)
NEO4J_HEAP=4G
NEO4J_PAGECACHE=4G

# Optional demo graph on AuraDB Free (stretch goal, after the full version works)
AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=

# NYC Open Data / data.ny.gov app token (optional; raises Socrata rate limits)
SOCRATA_APP_TOKEN=

# LangSmith (weeks 6–8)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nyc-landlord-research-kg

# Model provider (weeks 6–8)
ANTHROPIC_API_KEY=
