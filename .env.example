# Copy to .env (gitignored) and fill in.

# Neo4j Desktop (design note 0011). Always connect to this database and no other.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=nyclr

# Optional demo graph on AuraDB Free (stretch goal, after the full version works)
AURA_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
AURA_USERNAME=neo4j
AURA_PASSWORD=

# NYC Open Data / data.ny.gov app token (optional; raises Socrata rate limits)
SOCRATA_APP_TOKEN=

# LangSmith (weeks 6–8)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=nyc-landlord-research-kg

# Model provider (weeks 6–8)
ANTHROPIC_API_KEY=
