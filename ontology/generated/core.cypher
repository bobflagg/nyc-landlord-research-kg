WITH DISTINCT v0, v1
WHERE v1 IS NOT NULL AND NOT ((v1 IS :: STRING NOT NULL))
WITH count(*) AS violationCount, collect({label: head([l IN labels(v0) WHERE l IN ['Snapshot']] + labels(v0)), key: 'snapshot_id', keyValue: v0.`snapshot_id`, elementId: elementId(v0)})[0..$sampleSize] AS sample
