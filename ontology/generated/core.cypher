WITH DISTINCT v0, v1
WHERE v1 IS NOT NULL AND NOT ((v1 IS :: STRING NOT NULL))
RETURN 'SnapshotShape.snapshot_id.datatype' AS ruleId, 'wl:SnapshotShape' AS shape, 'wl:snapshot_id' AS path, 'sh:datatype' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Snapshot']] + labels(v0)), key: 'snapshot_id', keyValue: v0.`snapshot_id`, elementId: elementId(v0)} AS focus, v1 AS value, 'wl:SnapshotShape violates sh:datatype on wl:snapshot_id' AS message, [] AS details
LIMIT coalesce($limit, 9223372036854775807);

