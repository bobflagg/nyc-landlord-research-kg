// name: SnapshotShape.snapshot_id.pattern
// ruleId: wl:SnapshotShape/wl:snapshot_id/sh:pattern
MATCH (v0:`Snapshot`)
UNWIND CASE WHEN v0.`snapshot_id` IS NULL THEN [] WHEN v0.`snapshot_id` IS :: LIST<ANY> THEN v0.`snapshot_id` ELSE [v0.`snapshot_id`] END AS v1
WITH DISTINCT v0, v1
WHERE v1 IS NOT NULL AND NOT (CASE WHEN v1 IS :: STRING NOT NULL THEN v1 =~ '(?s:.*)(?:^[a-z][a-z0-9]*-[0-9]{4}-[0-9]{2}-[0-9]{2}(-r[0-9]+)?$)(?s:.*)' WHEN v1 IS :: INTEGER NOT NULL THEN toString(v1) =~ '(?s:.*)(?:^[a-z][a-z0-9]*-[0-9]{4}-[0-9]{2}-[0-9]{2}(-r[0-9]+)?$)(?s:.*)' ELSE false END)
RETURN 'SnapshotShape.snapshot_id.pattern' AS ruleId, 'wl:SnapshotShape' AS shape, 'wl:snapshot_id' AS path, 'sh:pattern' AS `constraint`, 'Violation' AS severity,
       {label: head([l IN labels(v0) WHERE l IN ['Snapshot']] + labels(v0)), key: 'snapshot_id', keyValue: v0.`snapshot_id`, elementId: elementId(v0)} AS focus, v1 AS value, 'wl:SnapshotShape violates sh:pattern on wl:snapshot_id' AS message, [] AS details
LIMIT coalesce($limit, 9223372036854775807);

