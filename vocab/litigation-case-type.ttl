@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ltype: <https://bobflagg.github.io/Watchline/vocab/litigation-case-type/> .

ltype: a skos:ConceptScheme ;
    dcterms:title "Litigation case type"@en ;
    dcterms:description "The case type of an HPD-initiated Housing Court action (design note 0020, C5)."@en ;
    dcterms:created "2026-10-28"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    skos:scopeNote "The notation is stored in case_type; the recorded value is always kept in case_type_raw. An HPD action is not an eviction and not a finding of liability."@en ;
    skos:hasTopConcept ltype:tenant_action, ltype:heat_and_hot_water, ltype:tenant_action_harassment, ltype:access_warrant_non_lead, ltype:comprehensive, ltype:false_certification_non_lead, ltype:access_warrant_lead, ltype:conh, ltype:comp_supplemental, ltype:lead_false_certification, ltype:seven_a, ltype:heat_supplemental, ltype:failure_to_register_only, ltype:other .

ltype:tenant_action a skos:Concept ;
    skos:inScheme ltype: ;
    skos:topConceptOf ltype: ;
    skos:notation "tenant_action" ;
    skos:prefLabel "Tenant action"@en ;
    skos:hiddenLabel "Tenant Action"@x-hpd ;
    skos:definition "HPD Tenant Action."@en .

ltype:heat_and_hot_water a skos:Concept ;
