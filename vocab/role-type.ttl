@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix role: <https://bobflagg.github.io/Watchline/vocab/role-type/> .

role: a skos:ConceptScheme ;
    dcterms:title "Role type"@en ;
    dcterms:description "What a record says a party is to a building or lot, normalized across sources. Names the role the record gives and never implies ownership or control."@en ;
    dcterms:created "2026-10-26"^^xsd:date ;
    owl:versionInfo "0.1.0" ;
    skos:scopeNote "Each concept's skos:notation is the string stored in role_type. skos:hiddenLabel with language tag x-hpd is the HPD contact type the loader maps from (design notes 0004 and 0014). The two groupings name what the record says, not who controls the building. skos:hiddenLabel with language tag x-acris is the ACRIS party type code, read together with the document type (note 0015). skos:hiddenLabel with language tag x-acris-by-type is the document type notation and the party code joined by a colon, for the parties of mortgage-family documents, whose meaning depends on the document type (note 0022); a party code with no label for its document type gets no role type. DOS roles are added with their module."@en ;
    skos:hasTopConcept role:registered_principal, role:management, role:deed_party, role:loan_party .

role:registered_principal a skos:Concept ;
    skos:inScheme role: ;
    skos:topConceptOf role: ;
    skos:notation "registered_principal" ;
    skos:prefLabel "Principal named in a registration"@en ;
    skos:definition "The owner, officers, shareholders and lessee a registration names. A grouping of what the record says; it implies no ownership or control."@en .

role:management a skos:Concept ;
    skos:inScheme role: ;
    skos:topConceptOf role: ;
    skos:notation "management" ;
    skos:prefLabel "Management"@en ;
    skos:definition "The managing agent and site manager a registration names. A management relationship, not ownership."@en .

role:registered_owner a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:registered_principal ;
    skos:notation "registered_owner" ;
    skos:prefLabel "Registered owner"@en ;
    skos:hiddenLabel "CorporateOwner"@x-hpd ;
    skos:hiddenLabel "IndividualOwner"@x-hpd ;
    skos:hiddenLabel "JointOwner"@x-hpd ;
    skos:definition "The party an HPD registration lists as owner, whether a corporation, an individual or joint owners. The owner kind is a property of the registration. A registration is who registered, not proof of title."@en .

role:head_officer a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:registered_principal ;
    skos:notation "head_officer" ;
    skos:prefLabel "Head officer"@en ;
    skos:hiddenLabel "HeadOfficer"@x-hpd ;
    skos:definition "The officer an HPD registration lists as head of the owning entity, with the title as recorded."@en .

role:officer a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:registered_principal ;
    skos:notation "officer" ;
    skos:prefLabel "Officer"@en ;
    skos:hiddenLabel "Officer"@x-hpd ;
    skos:definition "An officer an HPD registration lists for the owning entity, with the title as recorded."@en .

role:shareholder a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:registered_principal ;
    skos:notation "shareholder" ;
    skos:prefLabel "Shareholder"@en ;
    skos:hiddenLabel "Shareholder"@x-hpd ;
    skos:definition "A shareholder an HPD registration lists for the owning entity."@en .

role:managing_agent a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:management ;
    skos:notation "managing_agent" ;
    skos:prefLabel "Managing agent"@en ;
    skos:hiddenLabel "Agent"@x-hpd ;
    skos:definition "The building's disclosed managing agent. HPD labels this contact Managing Agent, and it is the only agent type in the data. A management relationship, not ownership."@en .

role:site_manager a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:management ;
    skos:notation "site_manager" ;
    skos:prefLabel "Site manager"@en ;
    skos:hiddenLabel "SiteManager"@x-hpd ;
    skos:definition "The person an HPD registration lists as site manager, the person a tenant can reach at the building."@en .

role:lessee a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:registered_principal ;
    skos:notation "lessee" ;
    skos:prefLabel "Lessee"@en ;
    skos:hiddenLabel "Lessee"@x-hpd ;
    skos:definition "A lessee an HPD registration lists for the building."@en .

role:deed_party a skos:Concept ;
    skos:inScheme role: ;
    skos:topConceptOf role: ;
    skos:notation "deed_party" ;
    skos:prefLabel "Party named on a deed"@en ;
    skos:definition "The grantor, grantee and life-estate party a deed names. A grouping of what the document says; a grantee is the party the document names as receiving title, not a finding of ownership."@en .

role:grantor a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:deed_party ;
    skos:notation "grantor" ;
    skos:prefLabel "Grantor"@en ;
    skos:hiddenLabel "1"@x-acris ;
    skos:definition "Party 1 on a deed-family document: the grantor (grantor/seller on most codes)."@en .

role:grantee a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:deed_party ;
    skos:notation "grantee" ;
    skos:prefLabel "Grantee"@en ;
    skos:hiddenLabel "2"@x-acris ;
    skos:definition "Party 2 on a deed-family document: the grantee."@en .

role:life_estate_retained a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:deed_party ;
    skos:notation "life_estate_retained" ;
    skos:prefLabel "Life estate retained"@en ;
    skos:hiddenLabel "3"@x-acris ;
    skos:scopeNote "Confirmed only on DEED, LE. Party 3 on any other deed code has no concept and is kept as the raw code (note 0015)."@en ;
    skos:definition "Party 3 on a DEED, LE document: the party that retains the life estate."@en .

role:loan_party a skos:Concept ;
    skos:inScheme role: ;
    skos:topConceptOf role: ;
    skos:notation "loan_party" ;
    skos:prefLabel "Party to a loan document"@en ;
    skos:definition "A party a mortgage-class document names. A grouping of what the record says; it implies no ownership or control."@en .

role:borrower a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:loan_party ;
    skos:notation "borrower" ;
    skos:prefLabel "Borrower"@en ;
    skos:hiddenLabel "mortgage:1"@x-acris-by-type ;
    skos:hiddenLabel "mortgage_consolidation:1"@x-acris-by-type ;
    skos:hiddenLabel "mortgage_correction:1"@x-acris-by-type ;
    skos:hiddenLabel "satisfaction:1"@x-acris-by-type ;
    skos:hiddenLabel "partial_satisfaction:1"@x-acris-by-type ;
    skos:definition "The mortgagor or borrower a mortgage-class document names (party 1 on a mortgage, consolidation, correction, satisfaction or partial satisfaction). What the record says; it implies nothing about the building's owner."@en .

role:lender a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:loan_party ;
    skos:notation "lender" ;
    skos:prefLabel "Lender"@en ;
    skos:hiddenLabel "mortgage:2"@x-acris-by-type ;
    skos:hiddenLabel "mortgage_consolidation:2"@x-acris-by-type ;
    skos:hiddenLabel "mortgage_correction:2"@x-acris-by-type ;
    skos:hiddenLabel "satisfaction:2"@x-acris-by-type ;
    skos:hiddenLabel "partial_satisfaction:2"@x-acris-by-type ;
    skos:definition "The mortgagee or lender a mortgage-class document names (party 2 on the same document types). What the record says."@en .

role:assignor a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:loan_party ;
    skos:notation "assignor" ;
    skos:prefLabel "Assignor"@en ;
    skos:hiddenLabel "assignment_of_mortgage:1"@x-acris-by-type ;
    skos:hiddenLabel "assignment_of_leases_rents:1"@x-acris-by-type ;
    skos:hiddenLabel "assignment_of_assignment_lr:1"@x-acris-by-type ;
    skos:definition "The assignor of a mortgage (the old lender) or of leases and rents."@en .

role:assignee a skos:Concept ;
    skos:inScheme role: ;
    skos:broader role:loan_party ;
    skos:notation "assignee" ;
    skos:prefLabel "Assignee"@en ;
    skos:hiddenLabel "assignment_of_mortgage:2"@x-acris-by-type ;
    skos:hiddenLabel "assignment_of_leases_rents:2"@x-acris-by-type ;
    skos:hiddenLabel "assignment_of_assignment_lr:2"@x-acris-by-type ;
    skos:definition "The assignee of a mortgage (the new lender) or of leases and rents."@en .
